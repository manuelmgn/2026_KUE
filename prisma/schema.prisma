generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Local development uses SQLite. For production PostgreSQL, prisma.config.ts selects
// prisma/schema.postgresql.prisma automatically based on DATABASE_URL.
datasource db {
  provider = "sqlite"
}

enum UserRole {
  USER
  ADMIN
}

enum ArtistStatus {
  PENDING
  LISTENING
  RATED
  DISCARDED
}

enum SyncStatus {
  PENDING
  SYNCING
  SYNCED
  FAILED
}

enum ReleaseType {
  ALBUM
  EP
  LIVE
  OTHER
}

enum LineupSyncMode {
  REVIEW
  AUTO
}

enum VisibilityScope {
  FRIENDS
  PRIVATE
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

enum NotificationType {
  FRIEND_REQUEST_RECEIVED
  FRIEND_REQUEST_ACCEPTED
  FESTIVAL_LINEUP_UPDATED
  FESTIVAL_METADATA_UPDATED
  FRIEND_JOINED_FESTIVAL
}

model User {
  id                  String          @id @default(cuid())
  username            String
  normalizedUsername  String          @unique
  email               String
  normalizedEmail     String          @unique
  passwordHash        String
  displayName         String?
  bio                 String          @default("")
  location            String?
  avatarPath          String?
  festivalsVisibility VisibilityScope @default(FRIENDS)
  ratingsVisibility   VisibilityScope @default(FRIENDS)
  notesVisibility     VisibilityScope @default(FRIENDS)
  role                UserRole        @default(USER)
  isActive            Boolean         @default(true)
  invitedByLinkId     String?
  lastLoginAt         DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  sessions            Session[]
  createdInvitations  InvitationLink[]           @relation("InvitationCreator")
  invitedByLink       InvitationLink?            @relation("InvitationUsedBy", fields: [invitedByLinkId], references: [id], onDelete: SetNull)
  editions            UserFestivalEdition[]
  artistStates        UserArtistState[]
  albumStates         UserAlbumState[]
  entryStates         UserEntryState[]
  createdFestivals    Festival[]            @relation("FestivalCreator")
  createdEditions     FestivalEdition[]     @relation("EditionCreator")
  sentFriendships     Friendship[]               @relation("FriendshipRequester")
  receivedFriendships Friendship[]               @relation("FriendshipAddressee")
  notifications       Notification[]             @relation("NotificationRecipient")
  actedNotifications  Notification[]             @relation("NotificationActor")
  createdComparisons  FestivalComparison[]       @relation("ComparisonCreator")
  comparisonMembers   FestivalComparisonMember[]
  createdJointAgendas JointAgenda[]              @relation("JointAgendaCreator")
  jointAgendaMembers  JointAgendaMember[]
  addedJointItems     JointAgendaItem[]          @relation("JointAgendaItemAdder")

  @@index([role])
  @@index([isActive])
  @@index([invitedByLinkId])
}

model InvitationLink {
  id          String    @id @default(cuid())
  token       String    @unique
  createdById String?
  maxUses     Int       @default(2)
  usedCount   Int       @default(0)
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  createdBy       User?  @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  registeredUsers User[] @relation("InvitationUsedBy")

  @@index([createdById])
  @@index([expiresAt])
  @@index([revokedAt])
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  expiresAt  DateTime
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model LegacyPersonalItem {
  id        String        @id @default(cuid())
  kind      String
  targetId  String
  rating    Int?
  status    ArtistStatus?
  notes     String        @default("")
  isPinned  Boolean       @default(false)
  customUrl String?

  @@index([kind])
}

model Artist {
  id             String     @id @default(cuid())
  name           String
  normalizedName String     @unique
  mbid           String?    @unique
  deezerId       String?
  country        String?
  bio            String?
  imagePath      String?
  syncStatus     SyncStatus @default(PENDING)
  syncError      String?
  syncedAt       DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  albums     Album[]
  entries    FestivalEntryArtist[]
  userStates UserArtistState[]

  @@index([syncStatus])
}

model Album {
  id          String      @id @default(cuid())
  artistId    String
  mbid        String?
  title       String
  releaseYear Int?
  releaseType ReleaseType @default(ALBUM)
  coverPath   String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  artist     Artist           @relation(fields: [artistId], references: [id], onDelete: Cascade)
  userStates UserAlbumState[]

  @@unique([artistId, mbid])
  @@index([artistId])
}

model Festival {
  id                  String   @id @default(cuid())
  slug                String   @unique
  name                String
  normalizedName      String   @unique
  location            String?
  locationProvince    String?
  locationRegion      String?
  locationCountry     String?
  locationCountryCode String?
  locationLatitude    Float?
  locationLongitude   Float?
  locationPlaceId     String?
  createdById         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  createdBy User?             @relation("FestivalCreator", fields: [createdById], references: [id], onDelete: SetNull)
  editions  FestivalEdition[]

  @@index([name])
}

model FestivalEdition {
  id                    String         @id @default(cuid())
  festivalId            String
  slug                  String         @unique
  year                  Int
  location              String?
  locationProvince      String?
  locationRegion        String?
  locationCountry       String?
  locationCountryCode   String?
  locationLatitude      Float?
  locationLongitude     Float?
  locationPlaceId       String?
  startDate             DateTime?
  endDate               DateTime?
  lineupSourceUrl       String?
  autoSyncEnabled       Boolean        @default(false)
  autoSyncMode          LineupSyncMode @default(REVIEW)
  syncIntervalHours     Int            @default(24)
  lastLineupSyncAt      DateTime?
  lastLineupContentHash String?
  lastLineupSyncError   String?
  pendingLineupDiff     String?
  createdById           String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  festival      Festival              @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  createdBy     User?                 @relation("EditionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  entries       FestivalEntry[]
  followers     UserFestivalEdition[]
  notifications Notification[]
  comparisons   FestivalComparison[]
  jointAgendas  JointAgenda[]

  @@unique([festivalId, year])
  @@index([year])
  @@index([festivalId])
}

model UserFestivalEdition {
  userId    String
  editionId String
  addedAt   DateTime @default(now())

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  edition FestivalEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@id([userId, editionId])
  @@index([editionId])
  @@index([userId, addedAt])
}

model FestivalEntry {
  id          String   @id @default(cuid())
  editionId   String
  billingName String
  subtitle    String?
  day         String?
  stage       String?
  setTime     String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  edition          FestivalEdition       @relation(fields: [editionId], references: [id], onDelete: Cascade)
  artists          FestivalEntryArtist[]
  userStates       UserEntryState[]
  jointAgendaItems JointAgendaItem[]

  @@index([editionId, day])
  @@index([editionId, sortOrder])
}

model FestivalEntryArtist {
  entryId  String
  artistId String
  position Int    @default(0)

  entry  FestivalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  artist Artist        @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([entryId, artistId])
  @@index([artistId])
}

model UserArtistState {
  userId    String
  artistId  String
  rating    Int?
  status    ArtistStatus @default(PENDING)
  notes     String       @default("")
  ratedAt   DateTime?
  updatedAt DateTime     @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([userId, artistId])
  @@index([userId, status])
  @@index([userId, rating])
  @@index([userId, ratedAt])
}

model UserAlbumState {
  userId    String
  albumId   String
  isPinned  Boolean  @default(false)
  customUrl String?
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@id([userId, albumId])
  @@index([userId, isPinned])
}

model UserEntryState {
  userId     String
  entryId    String
  liveRating Int?
  liveNotes  String   @default("")
  updatedAt  DateTime @updatedAt

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  entry FestivalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@id([userId, entryId])
  @@index([userId, updatedAt])
}

model Friendship {
  id          String           @id @default(cuid())
  pairKey     String           @unique
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  acceptedAt  DateTime?
  updatedAt   DateTime         @updatedAt

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@index([requesterId, status])
  @@index([addresseeId, status])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  actorId   String?
  editionId String?
  payload   String           @default("{}")
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user    User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor   User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  edition FestivalEdition? @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt])
  @@index([actorId])
  @@index([editionId])
}

model FestivalComparison {
  id          String   @id @default(cuid())
  editionId   String
  createdById String
  name        String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  edition      FestivalEdition            @relation(fields: [editionId], references: [id], onDelete: Cascade)
  createdBy    User                       @relation("ComparisonCreator", fields: [createdById], references: [id], onDelete: Cascade)
  members      FestivalComparisonMember[]
  jointAgendas JointAgenda[]

  @@index([editionId])
  @@index([createdById])
}

model FestivalComparisonMember {
  comparisonId String
  userId       String
  addedAt      DateTime @default(now())

  comparison FestivalComparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([comparisonId, userId])
  @@index([userId])
}

model JointAgenda {
  id                 String   @id @default(cuid())
  editionId          String
  comparisonId       String?
  createdById        String
  name               String   @default("")
  minRatingThreshold Float    @default(3.2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  edition    FestivalEdition     @relation(fields: [editionId], references: [id], onDelete: Cascade)
  comparison FestivalComparison? @relation(fields: [comparisonId], references: [id], onDelete: SetNull)
  createdBy  User                @relation("JointAgendaCreator", fields: [createdById], references: [id], onDelete: Cascade)
  members    JointAgendaMember[]
  items      JointAgendaItem[]

  @@index([editionId])
  @@index([comparisonId])
  @@index([createdById])
}

model JointAgendaMember {
  agendaId String
  userId   String
  addedAt  DateTime @default(now())

  agenda JointAgenda @relation(fields: [agendaId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([agendaId, userId])
  @@index([userId])
}

model JointAgendaItem {
  agendaId  String
  entryId   String
  addedById String?
  note      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agenda  JointAgenda   @relation(fields: [agendaId], references: [id], onDelete: Cascade)
  entry   FestivalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  addedBy User?         @relation("JointAgendaItemAdder", fields: [addedById], references: [id], onDelete: SetNull)

  @@id([agendaId, entryId])
  @@index([entryId])
}
