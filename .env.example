# Desarrollo local con SQLite:
DATABASE_URL="file:./prisma/dev.db"

# Producción con PostgreSQL externo (prisma.config.ts selecciona schema.postgresql.prisma automáticamente):
# - En la misma red Docker externa (postgres_net):
#   DATABASE_URL="postgresql://usuario:password@postgres:5432/kue?schema=public"
# - Si PostgreSQL corre en el host fuera de una red Docker compartida:
#   DATABASE_URL="postgresql://usuario:password@host.docker.internal:5432/kue?schema=public"

MEDIA_DIR="./data/media"
PORT=5030

# Opcional: Crear automáticamente el primer usuario administrador al arrancar si no hay usuarios
# ADMIN_USERNAME="admin"
# ADMIN_EMAIL="admin@example.com"
# ADMIN_PASSWORD="cambia-esta-password-segura"

# Opcional: Desactivar cookie Secure solo si accedes por HTTP sin TLS en red local
# COOKIE_SECURE="false"

# Opcional: Gemini API para extracción automática de carteles desde cualquier web oficial
# GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-3.5-flash-lite"
