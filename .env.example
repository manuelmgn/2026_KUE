# Desarrollo local con SQLite:
DATABASE_URL="file:./prisma/dev.db"

# Producción con PostgreSQL externo (cambiar provider = "postgresql" en prisma/schema.prisma):
# - En la misma red Docker externa (postgres_net):
#   DATABASE_URL="postgresql://usuario:password@postgres:5432/kue?schema=public"
# - Si PostgreSQL corre en el host fuera de una red Docker compartida:
#   DATABASE_URL="postgresql://usuario:password@host.docker.internal:5432/kue?schema=public"

MEDIA_DIR="./data/media"
PORT=5030
